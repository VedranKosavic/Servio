{
  "name": "sank",
  "type": "module",
  "private": true,
  "//imports": "Node subpath imports, so `#shared/*` resolves outside Nuxt too — `npm run db:seed` runs seed.ts through tsx with no Vite and no Nitro alias in sight, and server code imports real values (not just types) from shared/.",
  "imports": {
    "#shared/*": "./shared/*.ts"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt prepare && tsc --noEmit -p .nuxt/tsconfig.server.json && tsc --noEmit -p .nuxt/tsconfig.app.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx server/database/seed-cli.ts",
    "db:dev-pins": "node --env-file=.env --import tsx server/database/dev-pins.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@pinia/nuxt": "^0.11.2",
    "@vueuse/nuxt": "^13.9.0",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.44.6",
    "idb-keyval": "^6.3.0",
    "nuxt": "^4.5.2",
    "pinia": "^3.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/better-sqlite3": "^7.6.13",
    "@vite-pwa/nuxt": "^1.1.1",
    "drizzle-kit": "^0.31.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
