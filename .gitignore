node_modules
.nuxt
.output
dist
data/
*.db
*.db-wal
*.db-shm
.env
.env.*
# …except the template. `.env.example` holds no secret — it is the list of names
# a fresh clone has to fill in, and it is useless if it is not in the repo.
!.env.example
# Where your server lives, and the ssh user to reach it. Not a secret, but not
# anybody else's business either; `deploy/deploy.env.example` is the committed
# template it is copied from.
deploy/.deploy.env
# Photos, wherever UPLOAD_DIR points. `data/` above already covers the default
# (`data/uploads`); this catches a custom one and the verification run's
# `data/verify-uploads`.
uploads/
data/uploads/
data/verify-uploads/
.DS_Store

# Playwright's own output: traces, screenshots and the HTML report of a run.
# The specs are committed; what one run of them produced is not.
test-results/
playwright-report/
