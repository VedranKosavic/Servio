node_modules
.nuxt
.output
dist
data/
*.db
*.db-wal
*.db-shm
.env
.env.*
# …except the template. `.env.example` holds no secret — it is the list of names
# a fresh clone has to fill in, and it is useless if it is not in the repo.
!.env.example
# Where your server lives, and the ssh user to reach it. Not a secret, but not
# anybody else's business either; `deploy/deploy.env.example` is the committed
# template it is copied from.
deploy/.deploy.env
# Photos, wherever UPLOAD_DIR points. `data/` above already covers the default
# (`data/uploads`); these catch a custom one at the repo root and the
# verification run's `data/verify-uploads`.
#
# The leading slash is load-bearing: a bare `uploads/` matches **any** directory
# with that name at any depth, which silently swallowed `server/api/uploads/` —
# the two route files of `POST /api/uploads` and `GET /api/uploads/:id` — and a
# route that is not in the repo is a 403 in production and a red
# `route-roles.test.ts` at home.
/uploads/
data/uploads/
data/verify-uploads/
# …but `uploads/` above is a bare directory name, so git applies it at **every**
# level — including `server/api/uploads/`, which is source code and was silently
# untracked until this line brought it back. A directory has to be re-included
# before anything inside it can be.
!server/api/uploads/
.DS_Store

# Playwright's own output: traces, screenshots and the HTML report of a run.
# The specs are committed; what one run of them produced is not.
test-results/
playwright-report/
